  m_Script: {fileID: 11500000, guid: a4b488c86b9ab9a45bd0ccc96dd123bd, type: 3}
  m_Name: Dialogue Lider Comu
  m_EditorClassIdentifier: 
  npcName: Lider Comunitario
  npcPhoto: {fileID: 21300000, guid: 182acf71ddf9c950fa17aa1f5eb640e3, type: 3}
  dialogueLines:
  - "Hola, soy el l\xEDder comunitario de este sector. Estoy aqu\xED para apoyarte
    y orientarte en todo lo relacionado con la gesti\xF3n del riesgo."
  - "En Medell\xEDn, desde el DAGRD se promueve la creaci\xF3n y el fortalecimiento
    de comit\xE9s y comisiones de Gesti\xF3n del Riesgo, donde trabajamos junto a
    vecinos y voluntarios para estar mejor preparados, a trav\xE9s de capacitaciones,
    acompa\xF1amiento y trabajo articulado con las instituciones."
  - Te recomiendo mantenerte siempre informado, consulta el Geoportal del SIATA,
    revisa el SIRMED y mantente atento a las alarmas del Sistema de Alerta Temprana
    (SAT).
  - "Estas herramientas te ayudar\xE1n a actuar a tiempo y a tomar mejores decisiones
    para cuidar tu vida y la de quienes te rodean."
  npcText: "\xBFQu\xE9 haces ante una alerta de inundaci\xF3n?"
  options:
  - optionText: Quedarme en casa
    isCorrect: 0
    feedbackText: Incorrecto, debes evacuar.
  - optionText: Evacuar al punto seguro
    isCorrect: 1
    feedbackText: "\xA1Correcto! El punto de evacuaci\xF3n salva vidas."
  advancesStageOnCorrect: 0
  correctAnswerDelay: 1.5
