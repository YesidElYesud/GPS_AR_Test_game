  m_Script: {fileID: 11500000, guid: a4b488c86b9ab9a45bd0ccc96dd123bd, type: 3}
  m_Name: Dialogue Lider Comu 3
  m_EditorClassIdentifier: 
  npcName: Lider Comunitario
  npcPhoto: {fileID: 21300000, guid: 182acf71ddf9c950fa17aa1f5eb640e3, type: 3}
  dialogueLines:
  - "\xA1Vecino! Estamos en alerta roja. La quebrada se ha desbordado y hay inundaciones
    en el sector."
  - "Debes evacuar de inmediato. Sigue la ruta de evacuaci\xF3n y dir\xEDgete al
    punto de encuentro m\xE1s cercano. No te detengas en zonas inundadas."
  - "Recuerda que puedes consultar el SIATA y el SIRMED, pero en este momento lo
    m\xE1s importante es ponerte a salvo."
  npcText: "\xBFQu\xE9 haces ante una alerta de inundaci\xF3n?"
  options: []
  advancesStageOnCorrect: 0
  correctAnswerDelay: 1.5
